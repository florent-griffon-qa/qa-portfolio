{
  "name": "qa-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "QA automation portfolio: Postman/Newman API tests and Playwright UI tests, dockerized, with CI.",
  "license": "MIT",
  "author": "Florent Griffon",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "eslint . --max-warnings 0 && prettier --check . && tsc --noEmit",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "scan:denylist": "node scripts/denylist-scan.mjs",
    "scan:secrets": "node scripts/gitleaks.mjs staged",
    "scan:secrets:history": "node scripts/gitleaks.mjs history",
    "test:api": "node postman/run-newman.mjs",
    "test:api:public": "node postman/run-newman.mjs --env public",
    "audit:critical": "npm audit --audit-level=critical",
    "test:e2e": "playwright test --config playwright/playwright.config.ts",
    "test:smoke": "playwright test --config playwright/playwright.config.ts --grep @smoke",
    "test:e2e:report": "playwright show-report reports/e2e/html",
    "scan:denylist:history": "node scripts/denylist-scan.mjs --history"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-playwright": "2.12.1",
    "husky": "9.1.7",
    "newman": "6.2.3",
    "newman-reporter-htmlextra": "1.23.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "node-forge": "1.4.0",
    "lodash": "4.18.1",
    "flatted": "3.4.4",
    "jose": "4.15.9",
    "qs": "6.16.1",
    "underscore": "1.13.8"
  }
}
